---
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Eleva Patrimoine</title>
    <meta
      name="description"
      content="Eleva Patrimoine — site en construction."
    />
    <style>
      :root {
        --bg: #0f1b2d;
        --accent: #c9a24b;
        --text: #f5f3ee;
        --muted: #9fb0c3;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: "Georgia", "Times New Roman", serif;
        background: radial-gradient(circle at 50% 20%, #16273f 0%, var(--bg) 70%);
        color: var(--text);
      }
      main {
        text-align: center;
        padding: 2rem;
      }
      .brand {
        font-size: clamp(2.5rem, 8vw, 5rem);
        letter-spacing: 0.04em;
        margin: 0;
      }
      .brand span { color: var(--accent); }
      .tagline {
        font-family: system-ui, sans-serif;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.35em;
        font-size: 0.85rem;
        margin-top: 1rem;
      }
      .status {
        margin-top: 2.5rem;
        font-family: system-ui, sans-serif;
        font-size: 0.9rem;
        color: var(--muted);
      }
      .dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4ade80;
        margin-right: 0.5rem;
        vertical-align: middle;
      }
      footer {
        position: fixed;
        bottom: 1.25rem;
        font-family: system-ui, sans-serif;
        font-size: 0.75rem;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <main>
      <h1 class="brand">Eleva<span>.</span></h1>
      <p class="tagline">Patrimoine</p>
      <p class="status"><span class="dot"></span>Hello world — déploiement end-to-end opérationnel.</p>
    </main>
    <footer>&copy; {year} Eleva Patrimoine</footer>
  </body>
</html>
